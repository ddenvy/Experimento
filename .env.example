# Скопируйте этот файл в .env и заполните значения.
# Не коммитьте реальные секреты в систему контроля версий.

# JWT signing secret (HMAC SHA-256). Обязателен, минимум 32 символа (256 бит).
# Сгенерировать, например: openssl rand -base64 48
JWT_KEY=

# Origin фронтенда для CORS (необязательно, по умолчанию http://localhost:3000).
FRONTEND_ORIGIN=http://localhost:3000

# Gemini API key for LLM-powered rationale enrichment.
# Get a free key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=
